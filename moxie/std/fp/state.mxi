export tuple State[S, A]:
  run: (S) -> (A, S)

fn map_state[S, A, B](m: State[S, A], f: (A) -> B, s: S) (B, S):
  (a, s2) = m.run(s)
  (f(a), s2)

fn bind_state[S, A, B](m: State[S, A], f: (A) -> State[S, B], s: S) (B, S):
  (a, s2) = m.run(s)
  f(a).run(s2)

impl[S] Monad[State[S, _]]:
  fn map[A, B](self: State[S, A], f: (A) -> B) State[S, B]:
    State(run: (s): map_state(self, f, s))
  static fn pure[A](a: A) State[S, A]:
    State(run: (s): (a, s))
  fn ap[A, B](self: State[S, (A) -> B], x: State[S, A]) State[S, B]:
    self.flat_map((g): x.map(g))
  fn flat_map[A, B](self: State[S, A], f: (A) -> State[S, B]) State[S, B]:
    State(run: (s): bind_state(self, f, s))

export fn get[S]() State[S, S]:
  State(run: (s: S): (s, s))

export fn put[S](new: S) State[S, Unit]:
  State(run: (s: S): ((), new))

export fn modify[S](f: (S) -> S) State[S, Unit]:
  State(run: (s: S): ((), f(s)))

export fn gets[S, A](f: (S) -> A) State[S, A]:
  State(run: (s: S): (f(s), s))

export fn eval[S, A](m: State[S, A], s: S) A:
  m.run(s)(0)

export fn exec[S, A](m: State[S, A], s: S) S:
  m.run(s)(1)

export fn traverse[S, A, B](xs: List[A], f: (A) -> State[S, B]) State[S, List[B]]:
  State(run: (s: S): traverse_from(xs, 0, List(), f, s))

fn traverse_from[S, A, B](xs: List[A], i: Int, out: List[B], f: (A) -> State[S, B], s: S) (List[B], S):
  if i == len(xs):
    (out, s)
  else:
    (b, s2) = f(xs(i)).run(s)
    traverse_from(xs, i + 1, out + b, f, s2)
