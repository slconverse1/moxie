//! algo: well-known algorithms that are fastest with in-place writes, each a `mutable` block.
//!
//! Every function takes an array and gives back a new one: the array is copied in, the algorithm writes into the copy in
//! place, and the caller gets an ordinary immutable value, so none of these functions is visible from outside as anything but
//! a pure function. The sizes are compile-time sizes (`Array[T][N]`), so `N` is the same for the argument and the result.

/// The values in ascending order (an in-place quicksort with an explicit stack, so a long sorted input cannot overflow the
/// call stack).
///
/// > quicksort((5, 2, 9, 1, 5, 6))
/// Array(1, 2, 5, 5, 6, 9)
export fn quicksort[T Ordered, N](xs Array[T][N]) Array[T][N]
  mutable
    in xs
    lows Array[Int][N] = fill(0)
    highs Array[Int][N] = fill(0)
    top = 0
    if len(xs) > 1
      highs(0) = len(xs) - 1
      top = 1
    while top > 0
      top -= 1
      lo = lows(top)
      hi = highs(top)
      if lo < hi
        pivot = xs(hi)
        i = lo
        for j in lo..<hi
          if xs(j) < pivot
            tmp = xs(i)
            xs(i) = xs(j)
            xs(j) = tmp
            i += 1
        tmp = xs(i)
        xs(i) = xs(hi)
        xs(hi) = tmp
        if lo < i - 1
          lows(top) = lo
          highs(top) = i - 1
          top += 1
        if i + 1 < hi
          lows(top) = i + 1
          highs(top) = hi
          top += 1
    xs

/// The values in ascending order (an in-place heapsort: no stack, and the same speed whatever the input).
///
/// > heapsort((5, 2, 9, 1, 5, 6))
/// Array(1, 2, 5, 5, 6, 9)
export fn heapsort[T Ordered, N](xs Array[T][N]) Array[T][N]
  mutable
    in xs
    n = len(xs)
    start = n / 2
    while start > 0
      start -= 1
      root = start
      while 2 * root + 1 < n
        child = 2 * root + 1
        if child + 1 < n and xs(child) < xs(child + 1)
          child += 1
        if xs(root) < xs(child)
          tmp = xs(root)
          xs(root) = xs(child)
          xs(child) = tmp
          root = child
        else
          break
    end = n
    while end > 1
      end -= 1
      tmp = xs(0)
      xs(0) = xs(end)
      xs(end) = tmp
      root = 0
      while 2 * root + 1 < end
        child = 2 * root + 1
        if child + 1 < end and xs(child) < xs(child + 1)
          child += 1
        if xs(root) < xs(child)
          tmp = xs(root)
          xs(root) = xs(child)
          xs(child) = tmp
          root = child
        else
          break
    xs

/// The sieve of Eratosthenes: pass an array of `true`, and `flags(i)` comes back `true` exactly when `i` is a prime (0 and 1
/// are not).
///
/// ```
/// flags Array[Bool][10] = fill(true)
/// sieve(flags)   // false, false, true, true, false, true, false, true, false, false
/// ```
export fn sieve[N](flags Array[Bool][N]) Array[Bool][N]
  mutable
    in flags
    if len(flags) > 0
      flags(0) = false
    if len(flags) > 1
      flags(1) = false
    p = 2
    while p * p < len(flags)
      if flags(p)
        for m in (p * p)..<len(flags) step p
          flags(m) = false
      p += 1
    flags

/// Union-find with path halving and union by index: pass `Array(0, 1, 2, ...)` (each item its own root) and a list of edges,
/// and every item comes back labeled with the smallest item connected to it, so two items are connected exactly when their
/// labels are equal.
///
/// > components((0, 1, 2, 3, 4), List((0, 1), (3, 4), (1, 0)))
/// Array(0, 0, 2, 3, 3)
export fn components[N](parent Array[Int][N], edges List[(Int, Int)]) Array[Int][N]
  mutable
    in parent
    for (a, b) in edges
      x = a
      while parent(x) ~= x
        parent(x) = parent(parent(x))
        x = parent(x)
      y = b
      while parent(y) ~= y
        parent(y) = parent(parent(y))
        y = parent(y)
      if x < y
        parent(y) = x
      elif y < x
        parent(x) = y
    for i in 0..<len(parent)
      r = i
      while parent(r) ~= r
        r = parent(r)
      parent(i) = r
    parent

/// The values in ascending order, keeping equal values in their original order (a bottom-up merge sort that merges runs of
/// 1, 2, 4, ... items between the array and one scratch copy).
///
/// > merge_sort((5, 2, 9, 1, 5, 6))
/// Array(1, 2, 5, 5, 6, 9)
export fn merge_sort[T Ordered, N](xs Array[T][N]) Array[T][N]
  mutable
    in xs
    aux Array[T][N] = xs
    n = len(xs)
    width = 1
    while width < n
      lo = 0
      while lo < n
        mid = min(lo + width, n)
        hi = min(lo + 2 * width, n)
        i = lo
        j = mid
        k = lo
        while i < mid and j < hi
          if xs(j) < xs(i)
            aux(k) = xs(j)
            j += 1
          else
            aux(k) = xs(i)
            i += 1
          k += 1
        while i < mid
          aux(k) = xs(i)
          i += 1
          k += 1
        while j < hi
          aux(k) = xs(j)
          j += 1
          k += 1
        lo += 2 * width
      for t in 0..<n
        xs(t) = aux(t)
      width *= 2
    xs

/// The values in ascending order, for integers known to lie in `0..<limit`: count each value, then write them back (linear
/// time). A value outside the range aborts.
///
/// > counting_sort((3, 1, 2, 3, 0), 4)
/// Array(0, 1, 2, 3, 3)
export fn counting_sort[N](xs Array[Int][N], limit Int) Array[Int][N]
  mutable
    in xs
    counts List[Int] = List()
    for v in 0..<limit
      counts = counts + 0
    for x in xs
      counts(x) += 1
    pos = 0
    for v in 0..<limit
      c = counts(v)
      while c > 0
        xs(pos) = v
        pos += 1
        c -= 1
    xs

/// The index of `key` in an array that is already in ascending order, or an error when it is not there.
///
/// > binary_search((1, 3, 5, 7), 5)
/// Ok(2)
export fn binary_search[T Ordered, N](xs Array[T][N], key T) Result[Int, Error]
  mutable
    lo = 0
    hi = len(xs)
    while lo < hi
      mid = lo + (hi - lo) / 2
      if xs(mid) < key
        lo = mid + 1
      else
        hi = mid
    if lo < len(xs) and not (key < xs(lo))
      Ok(lo)
    else
      Err(Error(MISSING, "not found"))

/// Running totals: item `i` of the result is the sum of items `0` to `i`.
///
/// > prefix_sums((1, 2, 3, 4))
/// Array(1, 3, 6, 10)
export fn prefix_sums[N](xs Array[Int][N]) Array[Int][N]
  mutable
    in xs
    for i in 1..<len(xs)
      xs(i) += xs(i - 1)
    xs

/// The items moved left by `k` places, the ones pushed off the front coming back at the end (`k` may be larger than the
/// array, and negative to rotate the other way). Done by three reversals, in place.
///
/// > rotate((1, 2, 3, 4, 5), 2)
/// Array(3, 4, 5, 1, 2)
export fn rotate[T, N](xs Array[T][N], k Int) Array[T][N]
  mutable
    in xs
    n = len(xs)
    if n > 1
      s = ((k % n) + n) % n
      if s > 0
        lo = 0
        hi = s - 1
        while lo < hi
          tmp = xs(lo)
          xs(lo) = xs(hi)
          xs(hi) = tmp
          lo += 1
          hi -= 1
        lo = s
        hi = n - 1
        while lo < hi
          tmp = xs(lo)
          xs(lo) = xs(hi)
          xs(hi) = tmp
          lo += 1
          hi -= 1
        lo = 0
        hi = n - 1
        while lo < hi
          tmp = xs(lo)
          xs(lo) = xs(hi)
          xs(hi) = tmp
          lo += 1
          hi -= 1
    xs

/// A shuffle (Fisher-Yates) driven by a seed, so the same seed gives the same order: a function stays pure, and a different
/// seed gives a different order.
///
/// > shuffle((1, 2, 3, 4, 5), 42)
/// Array(1, 4, 3, 5, 2)
export fn shuffle[T, N](xs Array[T][N], seed Int) Array[T][N]
  mutable
    in xs
    s = seed % 2147483648
    i = len(xs) - 1
    while i > 0
      s = (s * 1103515245 + 12345) % 2147483648
      j = (s / 65536) % (i + 1)
      tmp = xs(i)
      xs(i) = xs(j)
      xs(j) = tmp
      i -= 1
    xs

/// The next arrangement in dictionary order, or an error when the array is already the last one (descending). Calling it
/// again and again from the sorted array walks through every distinct permutation once.
///
/// > next_permutation((1, 2, 3))
/// Ok(Array(1, 3, 2))
export fn next_permutation[T Ordered, N](xs Array[T][N]) Result[Array[T][N], Error]
  mutable
    in xs
    i = len(xs) - 2
    while i >= 0 and not (xs(i) < xs(i + 1))
      i -= 1
    if i < 0
      Err(Error(MISSING, "last permutation"))
    else
      j = len(xs) - 1
      while not (xs(i) < xs(j))
        j -= 1
      tmp = xs(i)
      xs(i) = xs(j)
      xs(j) = tmp
      lo = i + 1
      hi = len(xs) - 1
      while lo < hi
        tmp = xs(lo)
        xs(lo) = xs(hi)
        xs(hi) = tmp
        lo += 1
        hi -= 1
      Ok(xs)

/// The 0/1 knapsack: the best total value of items (given by their weights and values) that fit in `capacity`, each item used
/// at most once (a dynamic-programming table written in place).
///
/// > knapsack(List(1, 3, 4, 5), List(1, 4, 5, 7), 7)
/// 9
export fn knapsack(weights List[Int], values List[Int], capacity Int) Int
  mutable
    best List[Int] = List()
    for c in 0..capacity
      best = best + 0
    for i in 0..<len(weights)
      c = capacity
      while c >= weights(i)
        cand = best(c - weights(i)) + values(i)
        if cand > best(c)
          best(c) = cand
        c -= 1
    best(capacity)
