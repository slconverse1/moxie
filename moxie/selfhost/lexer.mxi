//! The first slice of moxie's lexer, written in moxie. It reads names, whole numbers, decimal numbers, strings without
//! interpolation, operators, comments, and line breaks, and gives the same tokens as the Python lexer for those.
//! `tests/run_selfhost.py` checks it against `moxie/lexer.py`.

export tuple Token:
  kind: String,
  text: String,
  line: Int,
  col: Int

fn is_digit(c: Char) Bool:
  c >= '0' and c <= '9'

fn is_id_start(c: Char) Bool:
  c == '_' or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

fn is_id_char(c: Char) Bool:
  is_id_start(c) or is_digit(c)

// The operators, longest first, so `|>>` wins over `|>` and `|`.
ops = List("...", "..=", "|>>", "<$>", "<*>", ">>=", "<<=",
           "<~", "~>", "|>", "->", "==", "~=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "+%", "-%",
           "&=", "|=", "^=", "<<", ">>", "++", "--", "..",
           "+", "-", "*", "/", "%", "<", ">", "=", "&", "|", "^", "~", "(", ")", "[", "]",
           "{", "}", ",", ":", ".", "?", "@", ";", "!", "$", "\\")

fn text_of(cs: List[Char], from: Int, to: Int) String:
  cs |> to_stream() |> drop(from) |> take(to - from) |> map((c): "$c") |> join("")

fn op_at(cs: List[Char], i: Int) String:
  for op in ops:
    n = len(op)
    if i + n <= len(cs) and text_of(cs, i, i + n) == op:
      return op
  ""

// Every raw token of `src`. A line break is an `NL` token. Anything outside the slice is an `ERR` token holding the character.
export fn lex(src: String) List[Token]:
  cs = chars(src) |> collect()
  n = len(cs)
  out = List[Token]()
  i = 0
  line = 1
  line_start = 0
  while i < n:
    c = cs(i)
    col = i - line_start + 1
    if c == '\n':
      gimme.1.out = out + Token(kind: "NL", text: "", line: line, col: col)
      gimme.1.i = i + 1
      gimme.1.line = line + 1
      gimme.1.line_start = i
    elif c == ' ':
      gimme.1.i = i + 1
    elif c == '/' and i + 1 < n and cs(i + 1) == '/':
      while i < n and cs(i) ~= '\n':
        gimme.1.i = i + 1
    elif is_id_start(c):
      j = i
      while j < n and is_id_char(cs(j)):
        gimme.1.j = j + 1
      gimme.1.out = out + Token(kind: "NAME", text: text_of(cs, i, j), line: line, col: col)
      gimme.1.i = j
    elif is_digit(c):
      j = i
      while j < n and is_digit(cs(j)):
        gimme.1.j = j + 1
      kind = "INT"
      if j + 1 < n and cs(j) == '.' and is_digit(cs(j + 1)):
        gimme.1.kind = "FLOAT"
        gimme.1.j = j + 1
        while j < n and is_digit(cs(j)):
          gimme.1.j = j + 1
      gimme.1.out = out + Token(kind: kind, text: text_of(cs, i, j), line: line, col: col)
      gimme.1.i = j
    elif c == '"':
      j = i + 1
      while j < n and cs(j) ~= '"':
        if cs(j) == '\\':
          gimme.1.j = j + 1
        gimme.1.j = j + 1
      gimme.1.out = out + Token(kind: "STR", text: text_of(cs, i, j + 1), line: line, col: col)
      gimme.1.i = j + 1
    else:
      op = op_at(cs, i)
      if op == "":
        gimme.1.out = out + Token(kind: "ERR", text: "$c", line: line, col: col)
        gimme.1.i = i + 1
      else:
        gimme.1.out = out + Token(kind: "OP", text: op, line: line, col: col)
        gimme.1.i = i + len(op)
  out

fn show_token(t: Token) String:
  "${t.kind}\t${t.text}\t${t.line}\t${t.col}"

