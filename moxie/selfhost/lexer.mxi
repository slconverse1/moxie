//! The first slices of moxie's lexer, written in moxie. `lex` reads names, numbers (decimal, hex, octal, binary, `_` separators, exponents, and suffixes), strings without
//! interpolation (also raw strings), chars, byte strings and chars, block comments, operators, comments, and line breaks. `structure` turns those tokens into logical lines with `NL`, `INDENT`,
//! and `DEDENT`, and `lex_lines` does both. They give the same tokens as the Python lexer for that part.
//! `tests/run_selfhost.py` checks it against `moxie/lexer.py`.

export tuple Token
  kind: String,
  text: String,
  line: Int,
  col: Int

fn is_digit(c: Char) Bool
  c >= '0' and c <= '9'

fn is_id_start(c: Char) Bool
  c == '_' or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

fn is_id_char(c: Char) Bool
  is_id_start(c) or is_digit(c)

// The operators, longest first, so `|>>` wins over `|>` and `|`.
ops = List("...", "..=", "|>>", "<$>", "<*>", ">>=", "<<=",
           "<~", "~>", "|>", "->", "==", "~=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "+%", "-%",
           "&=", "|=", "^=", "<<", ">>", "++", "--", "..",
           "+", "-", "*", "/", "%", "<", ">", "=", "&", "|", "^", "~", "(", ")", "[", "]",
           "{", "}", ",", ":", ".", "?", "@", ";", "!", "$", "\\")

fn text_of(cs: List[Char], from: Int, to: Int) String
  cs |> to_stream() |> drop(from) |> take(to - from) |> map((c) -> "$c") |> join("")

fn op_at(cs: List[Char], i: Int) String
  for op in ops
    n = len(op)
    if i + n <= len(cs) and text_of(cs, i, i + n) == op
      return op
  ""

// The scanner's state: where it is, which line it is on, where that line began, and the tokens so far.
tuple Lx
  i: Int,
  line: Int,
  line_start: Int,
  out: List[Token]

fn emit(st: Lx, kind: String, text: String, to: Int) Lx
  t = Token(kind: kind, text: text, line: st.line, col: st.i - st.line_start + 1)
  Lx(...st, i: to, out: st.out + t)

fn skip_while(cs: List[Char], from: Int, ok: (Char) -> Bool) Int
  for k in from..len(cs)
    if not ok(cs(k))
      break(k)
  else
    len(cs)

fn is_hex(c: Char) Bool
  is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')

fn is_alnum(c: Char) Bool
  is_id_char(c)

// A run of digits where a single `_` may sit between two digits (`1_000`).
fn skip_digits(cs: List[Char], from: Int) Int
  for k in from..len(cs)
    ok = is_digit(cs(k)) or (cs(k) == '_' and k > from and k + 1 < len(cs) and is_digit(cs(k + 1)) and is_digit(cs(k - 1)))
    if not ok
      break(k)
  else
    len(cs)

// The suffixes a number may carry, as the Python lexer lists them.
suffixes = List("i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f", "d", "ns", "us", "ms", "s", "m", "h")

// The suffix at `j` (not followed by a letter, digit, or `_`), or "".
fn suffix_at(cs: List[Char], j: Int) String
  for sx in suffixes
    n = len(sx)
    if j + n <= len(cs) and text_of(cs, j, j + n) == sx and (j + n == len(cs) or not is_alnum(cs(j + n)))
      return sx
  ""

fn is_radix(c: Char) Bool
  c == 'x' or c == 'X' or c == 'o' or c == 'O' or c == 'b' or c == 'B'

fn radix_digit(base: Char, c: Char) Bool
  c == '_' or (if base == 'x' or base == 'X' then is_hex(c) else (if base == 'o' or base == 'O' then c >= '0' and c <= '7' else c == '0' or c == '1'))

fn number_kind(suffix: String, is_float: Bool) String
  if suffix == "ns" or suffix == "us" or suffix == "ms" or suffix == "s" or suffix == "m" or suffix == "h"
    "DUR"
  elif suffix == "d"
    "DEC"
  elif suffix == "f" or is_float
    "FLOAT"
  else
    "INT"

fn scan_radix(cs: List[Char], st: Lx) Lx
  base = cs(st.i + 1)
  end = skip_while(cs, st.i + 2, (c) -> radix_digit(base, c))
  hex = base == 'x' or base == 'X'
  sx = suffix_at(cs, end)
  keep = if hex then (sx == "" or cs(end) == 'i' or cs(end) == 'u') else true
  stop = if keep then end + len(sx) else end
  emit(st, "INT", text_of(cs, st.i, stop), stop)

fn scan_decimal(cs: List[Char], st: Lx) Lx
  j = skip_digits(cs, st.i)
  frac = j + 1 < len(cs) and cs(j) == '.' and is_digit(cs(j + 1))
  k = if frac then skip_digits(cs, j + 1) else j
  sign = if k + 1 < len(cs) and (cs(k + 1) == '+' or cs(k + 1) == '-') then 1 else 0
  has_exp = k + 1 + sign < len(cs) and (cs(k) == 'e' or cs(k) == 'E') and is_digit(cs(k + 1 + sign))
  end = if has_exp then skip_while(cs, k + 1 + sign, is_digit) else k
  sx = suffix_at(cs, end)
  stop = end + len(sx)
  emit(st, number_kind(sx, frac or has_exp), text_of(cs, st.i, stop), stop)

fn scan_number(cs: List[Char], st: Lx) Lx
  if cs(st.i) == '0' and st.i + 1 < len(cs) and is_radix(cs(st.i + 1))
    scan_radix(cs, st)
  else
    scan_decimal(cs, st)

// A quoted token whose opening is `open` characters long (`"`, `'`, `b"`, `b'`) and whose closing character is `quote`.
// A backslash skips the character after it, so `\"` and `\'` do not end the token.
fn scan_quoted(cs: List[Char], st: Lx, open: Int, quote: Char, kind: String) Lx
  j = st.i + open
  end = while j < len(cs) and cs(j) ~= quote
    j = if cs(j) == '\\' then j + 2 else j + 1
  else
    j
  emit(st, kind, text_of(cs, st.i, end + 1), end + 1)

// How many `#` follow the `r` at `i`, when they are followed by `"` (a raw string opens there), otherwise -1.
fn raw_hashes(cs: List[Char], i: Int) Int
  h = skip_while(cs, i + 1, (c) -> c == '#') - (i + 1)
  if i + 1 + h < len(cs) and cs(i + 1 + h) == '"' then h else -1

// Does a raw string that opened with `h` hashes close at `k` (a `"` followed by `h` hashes)?
fn raw_closes(cs: List[Char], k: Int, h: Int) Bool
  k + h < len(cs) and cs(k) == '"' and skip_while(cs, k + 1, (c) -> c == '#') - (k + 1) >= h

fn scan_raw(cs: List[Char], st: Lx, h: Int) Lx
  j = st.i + 2 + h
  end = while j < len(cs) and not raw_closes(cs, j, h)
    j = j + 1
  else
    j
  stop = end + 1 + h
  emit(st, "STR", text_of(cs, st.i, stop), stop)

// A block comment, which nests. Its line breaks move the line count but make no `NL`.
tuple Cm
  k: Int,
  depth: Int,
  line: Int,
  ls: Int

fn pair_at(cs: List[Char], k: Int, a: Char, b: Char) Bool
  k + 1 < len(cs) and cs(k) == a and cs(k + 1) == b

fn comment_step(cs: List[Char], c: Cm) Cm
  if pair_at(cs, c.k, '/', '*')
    Cm(...c, k: c.k + 2, depth: c.depth + 1)
  elif pair_at(cs, c.k, '*', '/')
    Cm(...c, k: c.k + 2, depth: c.depth - 1)
  elif cs(c.k) == '\n'
    Cm(...c, k: c.k + 1, line: c.line + 1, ls: c.k + 1)
  else
    Cm(...c, k: c.k + 1)

fn skip_block_comment(cs: List[Char], st: Lx) Lx
  c = Cm(k: st.i + 2, depth: 1, line: st.line, ls: st.line_start)
  done = while c.k < len(cs) and c.depth > 0
    c = comment_step(cs, c)
  else
    c
  Lx(...st, i: done.k, line: done.line, line_start: done.ls)

fn scan_operator(cs: List[Char], st: Lx) Lx
  op = op_at(cs, st.i)
  if op == ""
    emit(st, "ERR", "${cs(st.i)}", st.i + 1)
  else
    emit(st, "OP", op, st.i + len(op))

// One step: the state after the token (or the blank, comment, or line break) at the current position.
fn step(cs: List[Char], st: Lx) Lx
  c = cs(st.i)
  if c == '\n'
    after = emit(st, "NL", "", st.i + 1)
    Lx(...after, line: st.line + 1, line_start: st.i + 1)
  elif c == ' '
    Lx(...st, i: st.i + 1)
  elif c == '/' and st.i + 1 < len(cs) and cs(st.i + 1) == '/'
    Lx(...st, i: skip_while(cs, st.i, (d) -> d ~= '\n'))
  elif c == '/' and pair_at(cs, st.i, '/', '*')
    skip_block_comment(cs, st)
  elif c == 'r' and raw_hashes(cs, st.i) >= 0
    scan_raw(cs, st, raw_hashes(cs, st.i))
  elif c == 'b' and pair_at(cs, st.i, 'b', '"')
    scan_quoted(cs, st, 2, '"', "BYTES")
  elif c == 'b' and pair_at(cs, st.i, 'b', '\'')
    scan_quoted(cs, st, 2, '\'', "BCHAR")
  elif is_id_start(c)
    end = skip_while(cs, st.i, is_id_char)
    emit(st, "NAME", text_of(cs, st.i, end), end)
  elif is_digit(c)
    scan_number(cs, st)
  elif c == '"'
    scan_quoted(cs, st, 1, '"', "STR")
  elif c == '\''
    scan_quoted(cs, st, 1, '\'', "CHAR")
  else
    scan_operator(cs, st)

// Every raw token of `src`. A line break is an `NL` token. Anything outside the slice is an `ERR` token holding the character.
export fn lex(src: String) List[Token]
  cs = chars(src) |> collect()
  st = Lx(i: 0, line: 1, line_start: 0, out: List[Token]())
  done = while st.i < len(cs)
    st = step(cs, st)
  else
    st
  done.out

// ---------------------------------------------------------------------------------------------------------------
// The second pass: logical lines, with NL, INDENT, and DEDENT (the same rules as `_structure` in moxie/lexer.py).

dangling = List("+", "-", "*", "/", "%", "==", "~=", "<", ">", "<=", ">=", "=", "&", "|", "^", "<<", ">>", "|>", "|>>",
                "~>", "<~", "<$>", "<*>", "+=", "-=", "*=", "/=", "%=", ",", "&=", "|=", "^=")
cont_starters = List("|>", "|>>", "~>", "<~", "<$>", "<*>")
word_ops = List("and", "or", "not", "in", "is")
accessors = List("get", "set", "priv", "did_set", "will_set")

fn has(xs: List[String], x: String) Bool
  xs |> any(_ == x)

fn mk(kind: String, line: Int) Token
  Token(kind: kind, text: "", line: line, col: 1)

// One physical line's tokens, in order, with the line breaks left out.
tuple Gp
  rows: List[List[Token]],
  cur: List[Token]

fn last_of(xs: List[Token]) Token
  xs(len(xs) - 1)

fn group_step(g: Gp, t: Token) Gp
  if t.kind == "NL"
    if len(g.cur) > 0 then Gp(rows: g.rows + List(g.cur), cur: List[Token]()) else g
  else
    Gp(...g, cur: g.cur + t)

fn group_lines(toks: List[Token]) List[List[Token]]
  g = Gp(rows: List[List[Token]](), cur: List[Token]())
  i = 0
  done = while i < len(toks)
    g = group_step(g, toks(i))
    i = i + 1
  else
    g
  if len(done.cur) > 0 then done.rows + List(done.cur) else done.rows

tuple Sx
  stack: List[Int],
  depth: Int,
  stmt_indent: Int,
  prev: List[Token],
  have_line: Bool,
  opens: Bool,
  out: List[Token]

fn drop_last(xs: List[Int]) List[Int]
  xs(..len(xs) - 1)

fn top_of(stack: List[Int]) Int
  stack(len(stack) - 1)

// Pops indentation levels deeper than `target`, giving a DEDENT for each.
fn dedent_to(sx: Sx, target: Int, line: Int) Sx
  st = sx
  done = while len(st.stack) > 1 and top_of(st.stack) > target
    st = Sx(...st, stack: drop_last(st.stack), out: st.out + mk("DEDENT", line))
  else
    st
  done

fn continues(sx: Sx, row: List[Token]) Bool
  first = row(0)
  if not sx.have_line
    false
  elif sx.depth > 0
    true
  else
    last = last_of(sx.prev)
    (last.kind == "OP" and has(dangling, last.text)) or (last.kind == "NAME" and has(word_ops, last.text)) \
      or (first.kind == "OP" and has(cont_starters, first.text)) \
      or (first.kind == "OP" and first.text == "." and len(row) > 1 and row(1).kind == "NAME" and row(1).col == first.col + 1)

fn bracket_delta(t: Token) Int
  if t.kind == "OP" and (t.text == "(" or t.text == "[" or t.text == "{")
    1
  elif t.kind == "OP" and (t.text == ")" or t.text == "]" or t.text == "}")
    -1
  else
    0

fn depth_after(depth: Int, row: List[Token]) Int
  depth + (row |> to_stream() |> map(bracket_delta) |> sum())

fn step_line(sx: Sx, row: List[Token]) Sx
  first = row(0)
  cont = continues(sx, row)
  st = if cont
    if sx.depth == 0 and first.kind == "OP" and (has(cont_starters, first.text) or first.text == ".")
      dedent_to(sx, sx.stmt_indent, first.line)
    else
      sx
  else
    ind = first.col - 1
    with_nl = if sx.have_line then Sx(...sx, out: sx.out + mk("NL", first.line)) else sx
    if ind > top_of(with_nl.stack)
      Sx(...with_nl, stack: with_nl.stack + ind, stmt_indent: ind, out: with_nl.out + mk("INDENT", first.line))
    elif ind < top_of(with_nl.stack)
      back = dedent_to(with_nl, ind, first.line)
      Sx(...back, stmt_indent: ind)
    else
      Sx(...with_nl, stmt_indent: ind)
  d = st.depth + depth_after(0, row)
  last = last_of(row)
  Sx(...st, depth: d, prev: row, have_line: true, opens: false, out: st.out + row)

// The tokens with NL, INDENT, and DEDENT in place, ending with EOF on line `last_line`.
export fn structure(toks: List[Token], last_line: Int) List[Token]
  rows = group_lines(toks)
  sx = Sx(stack: List(0), depth: 0, stmt_indent: 0, prev: List[Token](), have_line: false, opens: false, out: List[Token]())
  i = 0
  fin = while i < len(rows)
    sx = step_line(sx, rows(i))
    i = i + 1
  else
    sx
  closed = if fin.have_line then Sx(...fin, out: fin.out + mk("NL", last_line)) else fin
  tail = dedent_to(Sx(...closed, stack: closed.stack), 0, last_line)
  tail.out + mk("EOF", last_line)

// Every token of `src`, with logical lines.
export fn lex_lines(src: String) List[Token]
  toks = lex(src)
  structure(toks, 1 + (chars(src) |> filter((c) -> c == '\n') |> count()))

fn show_token(t: Token) String
  "${t.kind}\t${t.text}\t${t.line}\t${t.col}"

