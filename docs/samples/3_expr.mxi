// A recursive type and a function defined case by case.
enum Expr
  Num(n: Int),
  Add(l: Expr, r: Expr),
  Mul(l: Expr, r: Expr)

fn eval(e: Expr) Int
  when e
    Num(n) -> n
    Add(l, r) -> eval(l) + eval(r)
    Mul(l, r) -> eval(l) * eval(r)

e = Expr.Add(l: Num(n: 2), r: Mul(l: Num(n: 3), r: Num(n: 4)))
println("2 + 3 * 4 = ${eval(e)}")
