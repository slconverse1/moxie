// Three fibers send to one channel. The main fiber reads the results.
fiber fn worker(id Int, out ChanW[Int]) Unit
  _ = write(out, id * 10)

rx, tx = Chan[Int][3]()
_ = run worker(1, clone(tx))
_ = run worker(2, clone(tx))
_ = run worker(3, move tx)

a = read(rx).get_or(0)
b = read(rx).get_or(0)
c = read(rx).get_or(0)
println("total ${a + b + c}")
