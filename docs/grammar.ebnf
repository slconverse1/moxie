# The moxie grammar, over the token stream of moxie/lexer.py (the lexer has already joined continuation lines, so a statement
# ends at NL, a block is NL INDENT ... DEDENT, and brackets never contain NL).  Operator precedence is written out tier by tier.
# This grammar is checked against every code block of both guides (tests/run_grammar.py); where it is looser than the language
# (the checker, not the parser, rejects those programs) the comment says so.
%reserved fn if then else elif when for while in is not and or return break continue tuple enum interface impl type import using true false mutable forward

program : { NL } { item } EOF ;
item : decl | stmt ;

# ---------------------------------------------------------------- statements
stmt : simple { ';' simple } [ ';' ] NL | simple NL INDENT 'if' expr NL [ 'else' expr NL ] DEDENT | blockend | compound | target_list [ type ] '=' compound ;
simple : base [ 'if' expr [ 'else' expr ] ] | '...' expr ;
callblock : primary { '(' [ args ] ')' | '.' ident | '?' } '(' [ args ] ')' childblock ;
childblock : NL INDENT { stmt } DEDENT ;
base : 'break' 'daemon' | 'break' [ label ] '(' expr { ',' expr } ')' | 'export' ident [ type ] '=' expr | pattern [ type ] '=' expr 'else' expr | 'return' [ expr { ',' expr } ] | 'break' [ label ] [ '(' expr ')' ] | 'continue' [ label ] | binding | assign | expr { ',' expr } ;
blockend : [ target_list [ type ] '=' ] expr_b | 'return' expr_b ;
expr_b : pipe_b | postfix_b | callblock | lambda_b | fnblock | gofn | dotblock | postfix '+%' fnblock | pipe '|>' 'seq' armsx | when_b ;
lambda_b : '(' [ params ] ')' '->' ( block | when_b | postfix '.' 'update' updblock ) ;
dotblock : primary { '(' [ args ] ')' | '.' ident } ( '.' 'do' block | '.' 'update' updblock ) ;
gofn : 'go' 'fn' '(' [ params ] ')' [ '(' [ params ] ')' ] block ;
when_b : 'when' expr { ',' expr } armsx ;
pipe_b : pipe '|>' postfix_b | postfix_b ;
postfix_b : primary { '(' [ args ] ')' | '.' ident | '?' } '(' [ params ] ')' '->' ( block | when_b | postfix '.' 'update' updblock ) ;
fnblock : 'fn' [ tparams ] '(' [ params ] ')' [ type ] block ;
label : HASH ;
binding : target_list [ type ] '=' expr { ( ',' | '=' ) expr } ;
target_list : target { ',' target } ;
target : ident | '_' | '(' [ target_item { ',' target_item } ] ')' | ident { '.' ident } '(' [ target_item { ',' target_item } ] ')' ;
target_item : [ ident ':' ] target | ( '...' | '*' ) [ ident ] ;
assign : lvalue ( '=' | '+=' | '-=' | '*=' | '/=' | '%=' ) expr ;
lvalue : ( ident | 'self' ) { '(' [ args ] ')' | '.' ident | '.' INT } [ '@' ( INT | ident ) ] ;
compound : forallstmt | formonad | [ label ] ( ifstmt | whenstmt | forstmt | dostmt ) | mutable_block | block_stmt | armsblock ;
armsblock : ident NL INDENT arm+ DEDENT ;
armsx : NL INDENT arm+ DEDENT ;
dostmt : 'do' [ 'with' ident { ',' ident } ] block ;
block : NL INDENT [ carry ] item+ DEDENT ;
carry : 'in' carry_item { ',' carry_item } NL ;
carry_item : ident [ '@' ( INT | ident ) ] ;
fnbody : NL INDENT [ carry ] item+ DEDENT ;
block_stmt : ident [ ident ] block ;
ifstmt : 'if' expr ( 'then' simple NL | 'then' block | block ) { 'elif' expr ( 'then' simple NL | block ) } [ 'else' ( simple NL | block ) ] ;
whenstmt : 'when' [ expr { ',' expr } ] NL INDENT arm+ DEDENT ;
arm : arm_head '->' ( simple NL | block | when_b ) | 'else' ( simple NL | block ) ;
arm_head : pattern_alts { ',' pattern_alts } [ 'if' expr ] | ident '=' expr | expr | 'else' ;
pattern_alts : pattern { '|' pattern } ;
forstmt : 'for' ( pattern 'in' expr | expr ) ( block | 'then' simple NL ) [ 'else' ( simple NL | block ) ] ;
mutable_block : 'mutable' block ;

# ---------------------------------------------------------------- expressions
expr : pipe ;
pipe : orx | pipe '|>' stage | pipe binop orx ;
stage : postfix ;
binop : '~>' | '|>>' | '<$>' | '+' | '-' | '*' | '/' | '%' | '==' | '~=' | '<' | '>' | '<=' | '>=' | 'and' | 'or' ;
orx : andx { 'or' andx } ;
andx : cmp { 'and' cmp } ;
cmp : bor { ( '==' | '~=' | '<' | '>' | '<=' | '>=' | 'in' | 'not' 'in' ) bor | 'is' [ 'not' ] pattern } ;
bor : bxor { '|' bxor } ;
bxor : band { '^' band } ;
band : shift { '&' shift } ;
shift : add { ( '<<' | '>>' ) add } ;
add : mul { ( '+' | '-' | '+%' | '-%' ) mul } ;
mul : unary { ( '*' | '/' | '%' ) unary } ;
unary : ( 'not' | '-' | '~' ) unary | range ;
range : postfix [ ( '..' | '..=' | '..<' ) [ postfix ] [ 'step' unary ] ] ;
postfix : primary { '(' [ args ] ')' | '(' [ params ] ')' '->' ( expr | block ) | '.' 'do' block | '.' 'update' updblock | '.' ident | '.' INT | '?' | '[' type_args ']' | '@' INT } ;
args : arg { ',' arg } [ ',' ] ;
arg : '...' | '..' | '..=' | '$' ident [ '->' expr ] | [ 'ref' | 'using' | 'move' ] [ ident ':' ] [ '...' ] expr [ ':' expr ] [ '->' expr ] [ 'for' pattern 'in' expr [ 'if' expr ] ] | 'using' ;
primary : '(' 'in' expr ')' | '\\' ident [ '(' [ args ] ')' ] | '/' ident { '/' ident } | '{' expr { ',' expr } '}' | 'try_go' postfix | 'ref' postfix | 'when' expr armsx | 'sql' '(' expr ')' ':' SQL | 'for' NL INDENT { ( pattern 'in' expr | pattern '=' expr | 'if' expr | 'and' pattern 'in' expr | pattern '=' expr 'else' expr ) NL } 'yield' expr NL DEDENT | '(' binop ')' | '(' binop expr ')' | '(' expr binop ')' | 'go' [ 'fn' ] ( expr | lambda ) | '&' | '\\' ident '(' [ args ] ')' | '@' postfix | 'fn' [ tparams ] '(' [ params ] ')' [ type ] ( '=' expr | block ) | 'seq' armsx | 'todo' [ expr ] | HASH | ifexpr | lambda | tuplelit | ( INT | FLOAT ) [ unitexpr ] | STR | CHAR | DEC | DUR | BYTES | 'true' | 'false' | ident | '_' ;
tuplelit : '(' [ titem { ( ',' | ';' { ';' } ) titem } [ ',' ] ] ')' ;
titem : '...' | [ ident ] ':' expr | [ ident ':' ] [ '...' ] expr ;

# ---------------------------------------------------------------- patterns
pattern : ident '@' pattern_atom | pattern_atom ;
pattern_atom : 'in' range_pat | 'not' 'in' range_pat | '_' | ident | literal | '-' literal | '^' ident | '^' '(' expr ')' | ( '...' | '*' ) [ ident ]
             | '(' [ pat_item { ',' pat_item } ] ')' | ident { '.' ident } '(' [ pat_item { ',' pat_item } ] ')'
             | ( '<' | '>' | '<=' | '>=' ) literal | 'in' range_pat | 'not' 'in' range_pat
             | literal ( '..' | '..=' | '..<' ) literal ;
pat_item : [ ident ':' ] pattern ;
range_pat : range ;
literal : INT | FLOAT | STR | CHAR | DEC | 'true' | 'false' ;

# ---------------------------------------------------------------- types
type : type_atom { '|' type_atom } ;
type_item : type | ident type | '...' [ type ] | ident '...' ;
type_atom : '[' tparam { ',' tparam } ']' '->' type | '(' type ')' '[' type_args ']' | ident { '.' ident } [ '[' type_args ']' ] { '[' type_args ']' } | '(' [ type_item { ',' type_item } [ ',' ] ] ')' [ '->' type ] | type_atom '.' '(' [ type_item { ',' type_item } ] ')' '->' type | 'any' ident { '+' ident } | 'readonly' type ;
type_args : type_arg { ',' type_arg } ;
type_arg : type | '_' | STR | INT [ ( '..' | '..=' ) INT ] | unitexpr | '1' '/' unitexpr | '(' unitexpr ')' '^' INT ;

# ---------------------------------------------------------------- declarations
decl : { 'prints' | 'impure' | 'dynamic' | 'export' | 'static' | 'fiber' [ '[' INT ']' ] | 'inline' | 'tailrec' | 'forward' | 'pure' | 'pattern' | 'opaque' | 'union' } ( fndecl | tupledecl | enumdecl | ifacedecl | impldecl | aliasdecl ) | fwdtype | [ 'export' ] unitdecl | foreigndecl | importdecl | usingdecl | testdecl ;
fwdtype : 'forward' ( 'tuple' | 'enum' ) ident [ tparams ] NL ;
fndecl : 'fn' [ '(' [ 'ref' ] ident ')' ] fname [ tparams ] [ '(' [ params ] ')' ] [ type [ 'where' expr ] ] [ '(' ident { ',' ident } ')' ] [ 'if' expr ] ( '=' expr NL | '=' expr_b | fnbody | NL ) ;
hk : '_' [ '[' '_' { ',' '_' } ']' ] ;
tparams : '[' tparam { ',' tparam } ']' ;
tparam : ident [ '[' hk { ',' hk } ']' ] [ bound { '+' bound } ] [ 'where' expr ] ;
bound : ident [ '[' type_args ']' ] | '(' type_item { ',' type_item } [ ',' ] ')' ;
params : param { ',' param } ;
param : '(' target_item { ',' target_item } ')' | [ 'ref' | 'using' | 'move' | 'lazy' | 'block' ] ( ident [ '...' ] [ type ] | literal | 'self' ) [ 'where' expr ] [ '=' expr ] ;
tupledecl : 'tuple' ident [ tparams ] [ '(' [ params ] ')' ] [ derivs ] [ 'where' expr ] NL [ INDENT { tmember { ',' tmember } [ ',' ] NL [ INDENT { accessor | stmt } DEDENT ] } DEDENT ] ;
accessor : [ 'priv' ] ident [ '(' [ params ] ')' ] [ type ] ( block | NL ) ;
tmember : field | propdecl | 'invariant' expr ;
propdecl : [ 'lazy' | 'static' | 'priv' ] 'property' ident type [ '=' expr ] ;
derivs : 'deriving' ident { ',' ident } ;
field : ident type [ 'where' expr ] [ 'delegate' [ '(' type { ',' type } ')' ] ] [ '=' expr ] ;
enumdecl : 'enum' ident [ tparams ] [ '(' params ')' ] [ derivs ] NL INDENT { case { ',' case } [ ',' ] NL } DEDENT ;
case : ident [ '[' tparam { ',' tparam } ']' ] [ '(' [ case_item { ',' case_item } ] ')' ] [ '(' [ case_item { ',' case_item } ] ')' ] [ type ] ;
case_item : [ ident ':' ] ( param ) ;
ifacedecl : 'interface' ident [ tparams ] NL INDENT { member { ',' member } [ ',' ] NL [ INDENT { accessor | stmt } DEDENT ] | type { ',' type } NL } DEDENT ;
member : fnsig | 'type' ident | field | 'property' ident type | { 'static' | 'dynamic' } fnsig ;
fnsig : 'fn' [ '(' [ 'ref' ] ident ')' ] [ fname ] [ tparams ] [ '(' [ params ] ')' ] [ type [ 'where' expr ] ] ;
fname : ident | '+' | '-' | '*' | '/' | '==' | '<' | '>' | '<=' | '>=' | '%' | '|>>' | '<$>' | '~>' | '++' | '<<' | '>>' | '&' | '|' | '^' | '~=' ;
impldecl : 'impl' [ tparams ] type [ 'for' type ] [ 'proxy' '(' ident ')' ] NL [ INDENT { fndecl | 'type' ident '=' type NL | 'static' { 'dynamic' } fndecl | 'forward' fndecl } DEDENT ] ;
unitdecl : 'unit' ident [ '=' [ INT | FLOAT ] unitexpr ] NL ;
unitexpr : unitfactor { ( '*' | '/' ) unitfactor } ;
unitfactor : ident [ '^' INT ] ;
aliasdecl : 'type' ident [ tparams ] '=' ( type [ 'where' expr ] NL | 'when' type NL INDENT { tarm } DEDENT ) ;
tarm : type { ',' type } [ 'if' expr ] '->' typeres NL | 'else' typeres NL ;
typeres : tres { ( '+' | '-' | '*' ) tres } ;
tres : type | INT | STR ;
importdecl : 'import' ident { '.' ident } [ 'as' ident ] [ '(' ident { ',' ident } ')' ] NL ;
usingdecl : 'using' ident '=' expr NL ;
testdecl : 'test' STR block ;

ifexpr : 'if' expr 'then' expr { 'elif' expr 'then' expr } [ 'else' expr ] ;
lambda : '(' [ params ] ')' '->' ( expr | simple | block ) ;

formonad : 'for' NL INDENT { ( pattern 'in' expr | pattern '=' expr | 'if' expr | 'and' pattern 'in' expr | pattern '=' expr 'else' expr ) NL } 'yield' expr NL DEDENT ;
foreigndecl : 'foreign' STR NL INDENT { decl | 'handle' ident [ 'closes' ident ] NL } DEDENT ;
forallstmt : 'forall' ident type { ',' ident type } block ;
updblock : NL INDENT { updline } DEDENT ;
updline : { ident ':' expr ',' } ( ident ':' expr [ ',' ] NL | ident ':' NL INDENT { updline } DEDENT ) ;
